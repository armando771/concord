{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vite.web.config.ts",
    "vite.renderer.shared.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/renderer/src/shared/lib/serverUrl.ts",
    "src/renderer/src/features/overlay/lib/overlayState.ts",
    "src/renderer/src/features/overlay/lib/overlayLayout.ts",
    "src/renderer/src/features/overlay/lib/overlayShortcut.ts",
    "src/renderer/src/features/servers/lib/inviteLink.ts"

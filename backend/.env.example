# Copie este arquivo para `.env` e ajuste os valores.
#   cp .env.example .env
#
# O arquivo `.env` é ignorado pelo Git — nunca o commite.
# O mesmo arquivo é lido pelo backend Go e pelo `docker compose`.

# Porta HTTP/WebSocket do backend (é ela que vai no túnel TCP do playit).
PORT=8080
# Endereço de escuta. Vazio = todas as interfaces (playit/LAN). Numa VPS com
# Caddy na frente, use 127.0.0.1 para o backend não ficar exposto sem HTTPS.
HOST=

# Proxies cujo X-Forwarded-For vale para o IP do cliente (log e limite de
# tentativas de login). Vazio = automático: com HOST=127.0.0.1 (Caddy na mesma
# máquina) confia só no loopback; com qualquer outro HOST (playit/LAN) não
# confia em ninguém. Ou uma lista de IPs/CIDRs separados por vírgula, ou "none".
TRUSTED_PROXIES=

# Porta do Postgres no host (troque se a 5432 já estiver em uso).
POSTGRES_PORT=5432

# Conexão com o PostgreSQL (as migrations são aplicadas automaticamente no boot).
DATABASE_URL=postgres://concord-user:concord-password@localhost:5432/concord?sslmode=disable

# Segredo usado para assinar os tokens JWT (access + refresh).
# Gere um valor forte e único, por exemplo:
#   openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-forte-aqui

# ─── LiveKit (servidor de mídia das chamadas) ───────────────────
# Chave/segredo compartilhados entre o backend e o LiveKit.
#   openssl rand -hex 32
LIVEKIT_API_KEY=concord
LIVEKIT_API_SECRET=troque-por-um-segredo-forte-de-32-caracteres-ou-mais

# Porta HTTP interna do LiveKit. O backend faz proxy de /rtc para ela,
# então ela NÃO precisa de túnel.
LIVEKIT_PORT=7880

# Portas de mídia. Precisam ser IGUAIS às portas públicas que o playit
# atribuir aos túneis (TCP e UDP), porque o LiveKit anuncia a própria porta.
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

# IP público do túnel (playit/VPS). Vazio = IP local (bom para dev/LAN).
LIVEKIT_NODE_IP=

# Endereço público do backend (túnel TCP do playit). Usado por
# scripts/playit-watchdog.sh para reiniciar o playit se o túnel cair.
PUBLIC_URL=

# ─── E-mail (confirmação de e-mail e recuperação de senha) ──────
# Endereço PÚBLICO do app web, usado nos links dos e-mails (/verify-email e
# /reset-password). Sem barra no fim.
APP_URL=http://localhost:5173
# SMTP. Com SMTP_HOST ou MAIL_FROM vazios os e-mails só aparecem no log do
# backend (bom para dev). Porta 465 = TLS direto; as outras usam STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente, ex.: Salinha <nao-responder@seudominio.com>
MAIL_FROM=

# Pasta servida em /updates/ (atualização automática do app). Relativa ao
# diretório do backend. scripts/release-win.sh publica aqui.
UPDATES_DIR=updates

# Pasta da mídia do chat. Relativa ao diretório do backend. Na VPS fica em
# /opt/concord/uploads e o deploy nunca mexe nela.
# UPLOADS_DIR=uploads

# Abaixo desse espaço livre (GB) no disco do UPLOADS_DIR o servidor recusa
# uploads novos (o mesmo disco tem o Postgres e os instaladores).
UPLOADS_MIN_FREE_GB=5

# Propostas (quadro de melhorias). Aprovadas na votação viram issue no GitHub
# (token fine-grained com Issues: write). Sem os dois, ficam sem issue.
# TECH_TEAM_USER_IDS: ids (csv) de quem move os cards depois da votação.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
TECH_TEAM_USER_IDS=
